[Unit]
Description=OpenBAO Server Container
Wants=network-online.target
After=network-online.target

[Volume]
VolumeName=openbao-plugins
Label=app=openbao
Label=purpose=Plugins

[Volume]
VolumeName=openbao-config
Label=app=openbao
Label=purpose=configs

[Container]
ContainerName={{ openbao_container_name }}
Image={{ openbao_image }}

# OpenBao server command
Exec=server

# Container port
PublishPort={{ openbao_port }}:8200

# Persistent configuration and data
#Volume=openbao-config:/openbao/config:ro,Z
Volume=/opt/openbao/config:/openbao/config:ro,Z
Volume=/opt/openbao/tls:/openbao/tls:ro,Z
Volume=/opt/openbao/data:/openbao/data:Z
Volume=/opt/openbao/logs:/openbao/logs:Z

# PKCS#11 configuration
{% if openbao_seal_type == 'pkcs11' %}
Volume=/opt/openbao/plugins:/openbao/plugins:Z
Volume={{ openbao_pkcs11.library }}:/lib/softhsm/libsofthsm2.so:ro
Volume={{ softhsm_conf_path }}:/etc/softhsm2.conf:ro
Volume={{ softhsm_token_dir }}:{{ softhsm_token_dir }}:Z
#EnvironmentFile=/opt/openbao/config/openbao.env
Environment=SOFTHSM2_CONF=/etc/softhsm2.conf
Environment=BAO_HSM_PIN={{ softhsm_user_pin }}
{% endif %}

# Podman logging
GlobalArgs=--log-level=info

[Service]
Restart=always
RestartSec=5
LimitCORE=0

[Install]
WantedBy=default.target